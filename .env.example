# TypeSafe credential for System One and hybrid experiments.
TYPESAFE_API_KEY=
# Legacy name also accepted by the loader and provider client.
JEV_API_KEY=

# OpenRouter credential for LLM comparison and hybrid review.
OPENROUTER_API_KEY=

# CLI model defaults. The web comparison has its own model selectors.
OPENROUTER_MODEL=openai/gpt-oss-20b
JEV_MODEL=jev-1.13.0
